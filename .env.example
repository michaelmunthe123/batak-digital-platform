NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for Phase 4 admin invitations. Server-only; never expose to browser.
# Current Supabase projects use an sb_secret_... key.
SUPABASE_SECRET_KEY=

# Legacy fallback only when migrating an older project.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 5 — OpenAI + grounded AI
AI_ENABLED=true
OPENAI_API_KEY=
# Balanced default. You can override this with another Responses API model.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must stay 512 unless the pgvector migration is changed too.
OPENAI_EMBEDDING_DIMENSIONS=512
AI_MAX_CONTEXT_DOCS=8
AI_RATE_LIMIT_PER_10_MIN=20
# Keep false for privacy unless you intentionally want raw prompt logging.
AI_STORE_PROMPTS=false
# Use a long random string in production. It hashes anonymous rate-limit identifiers.
AI_SAFETY_HASH_SALT=
